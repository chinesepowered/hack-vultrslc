[Unit]
Description=Unbothered control plane (web app, agent loop, Capy gate, egress proxy)
After=docker.service network-online.target
Requires=docker.service

[Service]
WorkingDirectory=/opt/unbothered
EnvironmentFile=/opt/unbothered/.env
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
