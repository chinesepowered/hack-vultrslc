# Vultr Serverless Inference key (Vultr console: Serverless > Inference > your subscription)
VULTR_INFERENCE_API_KEY=
# Protects admin endpoints (/api/eval start, /api/admin/diag)
ADMIN_TOKEN=
# Optional overrides
# AGENT_MODEL=minimax-m3.1-flash
# GATE_MODEL=pplx-decider-v1.2
# VERIFY_MODEL=clef-flash
# SANDBOX_DRIVER=auto        # docker (gVisor tubs) or local (dev, no isolation)
# TUB_RUNTIME=runsc
# REGION_LABEL=Vultr Seattle
