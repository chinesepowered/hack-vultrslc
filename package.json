{
  "name": "unbothered",
  "version": "0.1.0",
  "private": true,
  "description": "Browser agents that do real work and ignore what web pages tell them to. Sandboxed on Vultr.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "eval": "tsx server/eval.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "framer-motion": "14.5.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
